              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/wallets/{walletId}/transactions": {
      "get": {
        "operationId": "listTransactions",
        "parameters": [
          {
            "name": "walletId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "deposit",
                "swap",
                "transfer"
              ]
            }
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "cNGN",
                "cGHS",
                "cXAF",
                "USDx",
                "EURx"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Wallet not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{transactionId}": {
      "get": {
        "operationId": "getTransaction",
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transaction"
                }
              }
            }
          },
          "400": {
            "description": "Invalid UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Transaction not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/rates": {
      "get": {
        "operationId": "getRates",
        "summary": "All 25 directed pairs, including identity pairs; live or labelled fixed fallback",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rates"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Wallet": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "phone",
          "createdAt"
        ]
      },
      "CreateWallet": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$"
          }
        },
        "required": [],
        "anyOf": [
          {
            "required": [
              "email"
            ]
          },
          {
            "required": [
              "phone"
            ]
          }
        ]
      },
      "Amount": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$",
        "description": "Positive decimal string; up to 18 integer and 6 fractional digits.",
        "example": "100.25"
      },
      "Deposit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          }
        },
        "required": [
          "currency",
          "amount"
        ]
      },
      "Swap": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fromCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ]
          },
          "toCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          }
        },
        "required": [
          "fromCurrency",
          "toCurrency",
          "amount"
        ]
      },
      "Transfer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recipientWalletId": {
            "type": "string",
            "format": "uuid"
          },
          "fromCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ]
          },
          "toCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          }
        },
        "required": [
          "recipientWalletId",
          "fromCurrency",
          "toCurrency",
          "amount"
        ]
      },
      "Transaction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "deposit",
              "swap",
              "transfer"
            ]
          },
          "sourceWalletId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "destinationWalletId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ]
          },
          "destinationCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ]
          },
          "sourceAmount": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{6}$",
            "example": "100.000000"
          },
          "destinationAmount": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{6}$",
            "example": "100.000000"
          },
          "rate": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{12}$",
            "example": "1.000000000000"
          },
          "rateSource": {
            "type": "string",
            "enum": [
              "live",
              "fixed"
            ],
            "nullable": true
          },
          "rateUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "type",
          "sourceWalletId",
          "destinationWalletId",
          "sourceCurrency",
          "destinationCurrency",
          "sourceAmount",
          "destinationAmount",
          "rate",
          "rateSource",
          "rateUpdatedAt",
          "createdAt"
        ]
      },
      "Rates": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "live",
              "fixed"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rates": {
            "type": "array",
            "minItems": 25,
            "maxItems": 25,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "enum": [
                    "cNGN",
                    "cGHS",
                    "cXAF",
                    "USDx",
                    "EURx"
                  ]
                },
                "to": {
                  "type": "string",
                  "enum": [
                    "cNGN",
                    "cGHS",
                    "cXAF",
                    "USDx",
                    "EURx"
                  ]
                },
                "rate": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]{12}$",
                  "example": "1.000000000000"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "from",
                "to",
                "rate",
                "updatedAt"
              ]
            }
          }
        },
        "required": [
          "source",
          "updatedAt",
          "rates"
        ]
      },
      "Balances": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "walletId": {
            "type": "string",
            "format": "uuid"
          },
          "balances": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "currency": {
                  "type": "string",
                  "enum": [
                    "cNGN",
                    "cGHS",
                    "cXAF",
                    "USDx",
                    "EURx"
                  ]
                },
                "amount": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]{6}$",
                  "example": "100.000000"
                },
                "usdValue": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]{6}$",
                  "example": "100.000000"
                }
              },
              "required": [
                "currency",
                "amount",
                "usdValue"
              ]
            }
          },
          "totalUsd": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{6}$",
            "example": "100.000000"
          },
          "rateSource": {
            "type": "string",
            "enum": [
              "live",
              "fixed"
            ]
          },
          "rateUpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "walletId",
          "balances",
          "totalUsd",
          "rateSource",
          "rateUpdatedAt"
        ]
      },
      "History": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
